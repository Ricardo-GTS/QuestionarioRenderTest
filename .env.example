# Postgres
POSTGRES_USER=questionario
POSTGRES_PASSWORD=questionario
POSTGRES_DB=questionario
DATABASE_URL=postgresql+psycopg://questionario:questionario@db:5432/questionario
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20

# Ollama
OLLAMA_HOST=http://ollama:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Regras de negocio (configuraveis, nunca hardcoded)
SIMILARITY_THRESHOLD=0.75
QUIZ_SIZE=10
REPORT_THRESHOLD=3

# Auth
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Administracao (painel do professor) -- lista de e-mails separados por virgula.
# Quem estiver aqui vira admin automaticamente no login (sem cadastro especial).
ADMIN_EMAILS=professor@example.com

# Login opcional com Google (alem do login por email/senha). Vazio = botao
# "Entrar com Google" nao funciona (token sempre rejeitado no backend), mas
# o resto do app funciona normalmente. Client ID criado em
# https://console.developers.google.com/apis/credentials -- usado por
# backend (audience do id_token) e frontend (mesmo valor, nao e' segredo).
GOOGLE_CLIENT_ID=

# Frontend -> Backend
API_BASE_URL=http://backend:8000
