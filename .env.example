# Postgres
POSTGRES_USER=questionario
POSTGRES_PASSWORD=questionario
POSTGRES_DB=questionario_django

# Ollama
OLLAMA_HOST=http://ollama:11434
OLLAMA_EMBED_MODEL=bge-m3

# Regras de negocio (valor inicial -- depois do primeiro boot, editavel em runtime
# em /admin/configuracoes, nunca hardcoded no codigo)
SIMILARITY_THRESHOLD=0.80
QUIZ_SIZE=10
REPORT_THRESHOLD=3

# Django
# Processos gunicorn (requests em paralelo). ~80 MB de RAM cada.
GUNICORN_WORKERS=4
# Quantos proxies (nginx, Cloudflare...) ficam na frente do Django. 0 = acesso direto.
# So' aumente se houver proxy de verdade: com isso, o IP do rate limit vem do
# X-Forwarded-For, que o proprio cliente conseguiria forjar sem proxy na frente.
TRUSTED_PROXY_COUNT=0
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Administracao (painel do professor) -- lista de e-mails separados por virgula.
# Quem estiver aqui vira admin automaticamente no login (sem cadastro especial).
ADMIN_EMAILS=professor@example.com

# Login opcional com Google (alem do login por email/senha). Vazio = botao
# "Entrar com Google" nao aparece. Client ID criado em
# https://console.developers.google.com/apis/credentials -- lembre de adicionar
# a origem (protocolo+host+porta) usada em "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# E-mail (codigo de confirmacao do cadastro/troca de e-mail).
# Dev com Docker: Mailpit (caixa de entrada falsa em http://localhost:8025).
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Questionario <nao-responda@localhost>

# Producao com Gmail: ative a verificacao em 2 etapas na conta e gere uma senha de
# app em https://myaccount.google.com/apppasswords. DEFAULT_FROM_EMAIL precisa ser o
# mesmo e-mail do EMAIL_HOST_USER (senao o Gmail recusa/troca o remetente).
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=seu-sistema@gmail.com
# EMAIL_HOST_PASSWORD=senha-de-app-de-16-caracteres
# DEFAULT_FROM_EMAIL=Questionario <seu-sistema@gmail.com>
