DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DJANGO_DATABASE_URL=postgresql://questionario:questionario@localhost:5432/questionario_django

SIMILARITY_THRESHOLD=0.80
QUIZ_SIZE=10
REPORT_THRESHOLD=3

ADMIN_EMAILS=admin@example.com

OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3

GOOGLE_CLIENT_ID=

# E-mail: vazio = o e-mail com o codigo sai no console do runserver. Para SMTP real,
# ver o bloco de e-mail no .env.example da raiz do repo.
EMAIL_HOST=
